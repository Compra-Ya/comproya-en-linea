# Copia este archivo a .env y completa con tu conexión real.
# Ejemplo local con Docker: postgresql://postgres:postgres@localhost:5432/comproya

DATABASE_URL="postgresql://usuario:password@localhost:5432/comproya"

# Opcional: cuántos productos como mínimo debe tener el catálogo sembrado.
# Por defecto 1200 (para superar 1000 con margen).
TARGET_PRODUCTS=1200
