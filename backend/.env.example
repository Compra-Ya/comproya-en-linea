# Copia este archivo a .env y completa con tu conexión real.
# Ejemplo local con Docker (ver ../docker-compose.yml): postgresql://postgres:comproya@localhost:5433/comproya

DATABASE_URL="postgresql://usuario:password@localhost:5433/comproya"

# Opcional: cuántos productos como mínimo debe tener el catálogo sembrado.
# Por defecto 1200 (para superar 1000 con margen).
TARGET_PRODUCTS=1200

# Firma y expiración de los JWT propios del módulo cuenta (docs/arquitectura.md
# sección 7). Cambiar el valor de ejemplo antes de desplegar a producción.
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Origen del frontend, para CORS y para las URLs de retorno de Stripe.
FRONTEND_ORIGIN="http://localhost:3000"

PORT=3001

# "false" desactiva los jobs programados (SupresionJob, LiberacionReservasJob)
# — útil en pruebas automatizadas, que llaman su lógica directamente sin
# depender del reloj. En desarrollo/producción déjalo en "true".
JOBS_ENABLED=true

# Stripe Checkout, modo de prueba (RN-06 — nunca se comitea una llave real).
# Se obtienen en https://dashboard.stripe.com (con el interruptor "Test mode"
# activado): Developers > API keys (secret + publishable) y Developers >
# Webhooks > tu endpoint > Signing secret.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Secreto compartido para verificar que la notificación de débito bancario
# (POST /pagos/debito/:orderId/notificacion, endpoint simulado — no hay
# pasarela de débito real conectada) viene de verdad de la pasarela y no de
# cualquiera. Se envía en el encabezado X-Debito-Secreto y se compara con
# crypto.timingSafeEqual. Cambiar antes de desplegar a producción.
DEBITO_NOTIFICATION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Cifra en reposo Payment.gatewayToken (el identificador que emite la
# pasarela, nunca un número de tarjeta — RN-06 se cumple sin excepción) antes
# de guardarlo en la base de datos (AES-256-GCM, dominio/cifrado-token.ts).
# Cambiar antes de desplegar a producción.
PAYMENT_TOKEN_ENCRYPTION_KEY="cambiar-por-un-secreto-largo-y-aleatorio"
